{
  "name": "allergens",
  "version": "1.0.0",
  "description": "CSS library with 14 icons for the allergens in Annex II of Regulation (EU) No 1169/2011.",
  "author": "M. de Ridder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthijsderidder/allergens.git"
  },
  "bugs": {
    "url": "https://github.com/matthijsderidder/allergens/issues"
  },
  "homepage": "https://github.com/matthijsderidder/allergens#readme",
  "keywords": [
    "css",
    "scss",
    "allergens",
    "icons",
    "webfont",
    "eu-1169-2011",
    "food-safety"
  ],
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/css/allergens.css",
  "style": "./dist/css/allergens.css",
  "sass": "./src/scss/allergens.scss",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "style": "./dist/css/allergens.css",
      "sass": "./src/scss/allergens.scss",
      "default": "./dist/css/allergens.css"
    },
    "./css": "./dist/css/allergens.css",
    "./css/min": "./dist/css/allergens.min.css",
    "./scss": "./src/scss/allergens.scss",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "jsdelivr": "dist/css/allergens.min.css",
  "unpkg": "dist/css/allergens.min.css"
}
